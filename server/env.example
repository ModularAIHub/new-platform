# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/autoverse_hub

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Encryption Configuration
ENCRYPTION_KEY=your-32-character-encryption-key-for-api-keys

# Domain Configuration
# For cross-domain services:
# - Local development: DOMAIN=localhost (cookies work only on localhost)
# - Production: DOMAIN=.yourdomain.com (cookies work across subdomains)
# - Single domain: DOMAIN=yourdomain.com (cookies work only on exact domain)
DOMAIN=autoverse.com
CLIENT_URL=http://localhost:3000

# Email Configuration
# Select "smtp" or "resend".
EMAIL_PROVIDER=smtp

# Gmail SMTP configuration
# Use a Google App Password; do not use your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SuiteGenie <your-email@gmail.com>
# Set true only when using port 465. Port 587 uses STARTTLS by default.
SMTP_SECURE=false

# Resend configuration (required only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=SuiteGenie <noreply@yourdomain.com>

# Redis Configuration
REDIS_URL=redis://localhost:6379
